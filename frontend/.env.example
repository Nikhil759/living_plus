# Supabase Auth (required for login in production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# static = SQLite demo store (seeded from frontend/data/*.json); api = FastAPI backend
NEXT_PUBLIC_DATA_SOURCE=static
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo SQLite: on when DATA_SOURCE=static; set 0 to read JSON imports only without .demo/demo.db
# DEMO_LOCAL_STORE=1
# DEMO_SQLITE_PATH=/absolute/path/to/demo.db
