# Supabase Auth (required for login in production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# api = FastAPI + SQLite; static = Next.js demo JSON / frontend/.demo/demo.db
NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo SQLite: on when DATA_SOURCE=static (local dev only; auto-off on Vercel).
# Set 0 to read bundled JSON without .demo/demo.db; set 1 to force SQLite (not for serverless).
# DEMO_LOCAL_STORE=0
# DEMO_LOCAL_STORE=1
# DEMO_SQLITE_PATH=/absolute/path/to/demo.db
