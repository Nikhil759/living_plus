# Copy to .env and fill in. Never commit .env.

# local | test | staging | production
ENV=local

# Local dev only: API calls without a Bearer token act as this seeded user (see scripts/seed.py).
LOCAL_DEV_AUTH_EMAIL=demo@aangan.app

# FastAPI SQLite file (created on first migrate). Path is relative to backend/.
DATABASE_URL=sqlite+aiosqlite:///./.demo/aangan.db

SUPABASE_URL=https://your-project-ref.supabase.co

# Exact origin of the Next.js app (no trailing path). Used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Upstash: rediss://default:<password>@<host>:6379 (local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Tests only (read by tests/conftest.py, not by the app). Filename must contain _test.
TEST_DATABASE_URL=sqlite+aiosqlite:///./.demo/aangan_test.db

# Event cover uploads (created on first upload). Path is relative to backend/.
UPLOAD_DIR=./.uploads

# Saarthi (Google Gemini). Without a key the app runs but Saarthi reports it's unavailable.
GEMINI_API_KEY=
GEMINI_MODEL_MAIN=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Thinking effort for chat models: low (faster tool turns, same eval score), medium, high; empty = model default.
GEMINI_REASONING_EFFORT=low
SAARTHI_TIMEOUT_SECONDS=30
SAARTHI_HISTORY_MESSAGES=20
SAARTHI_MAX_MESSAGE_CHARS=2000
# Per-resident chat limits (rate limits use REDIS_URL when reachable, else in-process).
SAARTHI_CHAT_PER_10MIN=30
SAARTHI_CHAT_PER_DAY=200
SAARTHI_ACTIONS_PER_HOUR=30
# Rupee estimate on the committee AI usage page.
USD_TO_INR=88

# Optional Langfuse tracing (off unless both keys are set).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
