# Copy to .env and fill in. Never commit .env.

# local | test | staging | production
ENV=local

# Must use the asyncpg driver. Supabase: Project Settings > Database > Connection string.
# Use the direct connection (port 5432) for Alembic migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aangan

SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase: Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=change-me

# Exact origin of the Next.js app (no trailing path). Used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Upstash: rediss://default:<password>@<host>:6379 (local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Tests only (read by tests/conftest.py, not by the app). Database name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aangan_test
