# Copy to .env and fill in. Never commit .env.

# local | test | staging | production
ENV=local

# Local dev only: API calls without a Bearer token act as this seeded user (see scripts/seed.py).
LOCAL_DEV_AUTH_EMAIL=demo@aangan.app

# FastAPI SQLite file (created on first migrate). Path is relative to backend/.
DATABASE_URL=sqlite+aiosqlite:///./.demo/aangan.db

SUPABASE_URL=https://your-project-ref.supabase.co

# Exact origin of the Next.js app (no trailing path). Used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Upstash: rediss://default:<password>@<host>:6379 (local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Tests only (read by tests/conftest.py, not by the app). Filename must contain _test.
TEST_DATABASE_URL=sqlite+aiosqlite:///./.demo/aangan_test.db
