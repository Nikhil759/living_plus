# Copy to .env and fill in. Never commit .env.

# local | test | staging | production
ENV=local

# Local dev only: API calls without a Bearer token act as this seeded user (see scripts/seed.py).
LOCAL_DEV_AUTH_EMAIL=demo@aangan.app

# Must use the asyncpg driver. Supabase: Connect > Direct connection (db.<ref>.supabase.co:5432).
# URL-encode special characters in the password. The direct host is IPv6-only; use the
# pooler string (user postgres.<ref>, port 6543) from IPv4-only hosts such as most PaaS.
# Never point TEST_DATABASE_URL at this database.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres

SUPABASE_URL=https://your-project-ref.supabase.co

# Exact origin of the Next.js app (no trailing path). Used for CORS.
FRONTEND_ORIGIN=http://localhost:3000

# Upstash: rediss://default:<password>@<host>:6379 (local: redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Tests only (read by tests/conftest.py, not by the app). Database name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aangan_test
